# GoGate Environment Variables
# Copy to .env and update values before starting.

# Admin master key — exchange for admin JWT via POST /api/admin/auth/master-key
goget_MASTER_KEY=sk-master-dev-key-change-in-production

# Provider API keys (at least one required)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=

# JWT signing secret for admin session tokens
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this

# Database (defaults match docker compose)
DATABASE_URL=postgres://goget:goget@localhost:5432/goget?sslmode=disable

# Redis (defaults match docker compose)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
