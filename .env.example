# Copy to .env and fill these values. Never commit .env.
# Used by both `go run` (godotenv) and Docker Compose.
goget_MASTER_KEY=
JWT_SECRET_KEY=

# The shared config currently selects Gemini via its OpenAI-compatible endpoint.
GEMINI_API_KEY=
# Optional: use these if you add OpenAI or Anthropic models to config/config.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Host-side ports from Docker Compose. Compose overrides URLs inside the container.
DATABASE_URL=postgres://goget:goget@localhost:5432/goget?sslmode=disable
REDIS_URL=redis://localhost:6380

LOG_LEVEL=info
LOG_FORMAT=json
# Optional explicit YAML path (otherwise config.yaml is searched in standard locations).
# CONFIG_FILE=./config/config.yaml
