# Copy to secret.yaml and fill values from `terraform output` + your .env.
# Never commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: gogate-secrets
  namespace: gogate
type: Opaque
stringData:
  DATABASE_URL: "postgres://goget:REPLACE@REPLACE:5432/goget?sslmode=require"
  REDIS_URL: "redis://REPLACE:6379"
  JWT_SECRET_KEY: "REPLACE_WITH_LONG_RANDOM"
  goget_MASTER_KEY: "REPLACE_MASTER_KEY"
  AUTH_MASTER_KEY: "REPLACE_MASTER_KEY"
  # Active provider for this project (see config.yaml model_list)
  GEMINI_API_KEY: "REPLACE_GEMINI_KEY"
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
